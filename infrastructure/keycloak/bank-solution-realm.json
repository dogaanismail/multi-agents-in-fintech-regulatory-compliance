{
  "realm": "bank-solution",
  "displayName": "Bank Solution Backoffice",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Reads payments, customers, accounts, risk assessments and the MARL dashboards"
      },
      {
        "name": "operator",
        "description": "Creates customers, accounts and payments",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "compliance-officer",
        "description": "Approves and rejects payments under manual review and overrides final decisions",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Changes platform configuration, triggers MARL training and posts to the ledger",
        "composite": true,
        "composites": {
          "realm": [
            "operator",
            "compliance-officer"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "backoffice",
      "name": "Backoffice",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BACKOFFICE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${BACKOFFICE_URL}/login/oauth2/code/keycloak",
        "${BACKOFFICE_DEV_SERVER_URL}/login/oauth2/code/keycloak"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${BACKOFFICE_URL}/##${BACKOFFICE_DEV_SERVER_URL}/"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "email": "viewer@bank-solution.local",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    },
    {
      "username": "operator",
      "email": "operator@bank-solution.local",
      "emailVerified": true,
      "firstName": "Omar",
      "lastName": "Operator",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "officer",
      "email": "officer@bank-solution.local",
      "emailVerified": true,
      "firstName": "Clara",
      "lastName": "Compliance",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "compliance-officer"
      ]
    },
    {
      "username": "admin",
      "email": "admin@bank-solution.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
