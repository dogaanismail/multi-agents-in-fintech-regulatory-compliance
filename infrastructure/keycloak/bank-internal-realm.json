  ],
  "users": [
    {
      "username": "service-account-account-service",
      "enabled": true,
      "serviceAccountClientId": "account-service",
      "clientRoles": {
        "bank-platform": [
          "ledger.post",
          "customer.read"
        ]
      }
    },
    {
      "username": "service-account-risk-engine-service",
      "enabled": true,
      "serviceAccountClientId": "risk-engine-service",
      "clientRoles": {
        "bank-platform": [
          "account.read",
          "customer.read",
          "risk.read"
        ]
      }
    },
    {
      "username": "service-account-payment-service",
      "enabled": true,
      "serviceAccountClientId": "payment-service",
      "clientRoles": {
        "bank-platform": [
          "account.read"
        ]
      }
    },
    {
      "username": "service-account-beneficiary-service",
      "enabled": true,
      "serviceAccountClientId": "beneficiary-service",
      "clientRoles": {
        "bank-platform": [
          "customer.read"
        ]
      }
    },
    {
      "username": "service-account-marl-orchestrator",
      "enabled": true,
      "serviceAccountClientId": "marl-orchestrator",
      "clientRoles": {
        "bank-platform": [
          "configuration.read"
        ]
      }
    },
    {
      "username": "service-account-mobile-gateway",
      "enabled": true,
      "serviceAccountClientId": "mobile-gateway",
      "clientRoles": {
        "bank-platform": [
          "customer.onboard",
          "customer.read",
          "account.read",
          "account.open",
          "payment.create",
          "payment.read"
        ]
      }
    }
  ]
}
