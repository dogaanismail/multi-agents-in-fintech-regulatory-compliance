    },
    {
      "clientId": "mobile-gateway",
      "name": "mobile-gateway",
      "description": "Machine identity of mobile-gateway for calls to customer-service, account-service, payment-service, payment-history-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MOBILE_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
