environments:
  local:
    values:
      - environments/local/environment.yaml
---
helmDefaults:
  kubeContext: {{ .Values.kubeContext }}
  wait: true
  timeout: 600
  createNamespace: true

repositories:
  - name: strimzi
    url: quay.io/strimzi-helm
    oci: true
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts

templates:
  data:
    missingFileHandler: Info
    values:
      - data/{{`{{ .Release.Namespace }}`}}/{{`{{ .Release.Name }}`}}.yaml
      - environments/{{`{{ .Environment.Name }}`}}/{{`{{ .Release.Name }}`}}.yaml

  service:
    missingFileHandler: Error
    values:
      - services/{{`{{ .Release.Namespace }}`}}/{{`{{ .Release.Name }}`}}.yaml
      - environments/{{`{{ .Environment.Name }}`}}/services.yaml

releases:
  - name: strimzi-operator
    namespace: platform
    chart: strimzi/strimzi-kafka-operator
    version: 1.2.0
    labels:
      tier: operators
    values:
      - platform/strimzi/values.yaml

  - name: cloudnative-pg
    namespace: cnpg-system
    chart: cnpg/cloudnative-pg
    version: 0.29.1
    labels:
      tier: operators
    values:
      - platform/cloudnative-pg/values.yaml

  - name: kafka
    namespace: platform
    chart: charts/platform/kafka
    inherit:
      - template: data
    labels:
      tier: platform
    needs:
      - platform/strimzi-operator
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["--context", "{{ .Values.kubeContext }}", "--namespace", "platform", "wait", "kafka/bank-kafka", "--for=condition=Ready", "--timeout=600s"]

  - name: schema-registry
    namespace: platform
    chart: charts/platform/schema-registry
    inherit:
      - template: data
    labels:
      tier: platform
    needs:
      - platform/kafka

  - name: bank-postgres
    namespace: banking
    chart: charts/data/postgres
    inherit:
      - template: data
    labels:
      tier: data
    needs:
      - cnpg-system/cloudnative-pg
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["--context", "{{ .Values.kubeContext }}", "--namespace", "banking", "wait", "cluster/bank-postgres", "--for=condition=Ready", "--timeout=600s"]
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["--context", "{{ .Values.kubeContext }}", "--namespace", "banking", "wait", "database", "--all", "--for=jsonpath={.status.applied}=true", "--timeout=300s"]

  - name: ai-postgres
    namespace: ai
    chart: charts/data/postgres
    inherit:
      - template: data
    labels:
      tier: data
    needs:
      - cnpg-system/cloudnative-pg
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["--context", "{{ .Values.kubeContext }}", "--namespace", "ai", "wait", "cluster/ai-postgres", "--for=condition=Ready", "--timeout=600s"]
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args: ["--context", "{{ .Values.kubeContext }}", "--namespace", "ai", "wait", "database", "--all", "--for=jsonpath={.status.applied}=true", "--timeout=300s"]

  - name: neo4j
    namespace: banking
    chart: charts/data/neo4j
    inherit:
      - template: data
    labels:
      tier: data

  - name: tigerbeetle
    namespace: banking
    chart: charts/data/tigerbeetle
    inherit:
      - template: data
    labels:
      tier: data

  - name: configuration-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres

  - name: customer-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres

  - name: account-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: customer-profile-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: payment-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: payment-history-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: payment-engine-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: risk-engine-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - platform/schema-registry

  - name: network-topology-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/bank-postgres
      - banking/neo4j
      - platform/schema-registry

  - name: ledger-service
    namespace: banking
    chart: charts/service-types/java-microservice
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/tigerbeetle
      - platform/schema-registry

  - name: backoffice-gateway
    namespace: banking
    chart: charts/service-types/gateway
    inherit:
      - template: service
    labels:
      tier: banking

  - name: backoffice-ui
    namespace: banking
    chart: charts/service-types/frontend
    inherit:
      - template: service
    labels:
      tier: banking
    needs:
      - banking/backoffice-gateway

  - name: transaction-pattern-agent
    namespace: ai
    chart: charts/service-types/ai-agent
    inherit:
      - template: service
    labels:
      tier: ai

  - name: customer-risk-agent
    namespace: ai
    chart: charts/service-types/ai-agent
    inherit:
      - template: service
    labels:
      tier: ai

  - name: network-analysis-agent
    namespace: ai
    chart: charts/service-types/ai-agent
    inherit:
      - template: service
    labels:
      tier: ai

  - name: marl-orchestrator
    namespace: ai
    chart: charts/service-types/ai-service
    inherit:
      - template: service
    labels:
      tier: ai
    needs:
      - ai/ai-postgres
      - platform/schema-registry
      - ai/transaction-pattern-agent
      - ai/customer-risk-agent
      - ai/network-analysis-agent
