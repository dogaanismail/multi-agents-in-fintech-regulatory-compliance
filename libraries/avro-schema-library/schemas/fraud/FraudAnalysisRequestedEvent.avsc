{
  "namespace": "com.aml.fraud",
  "type": "record",
  "name": "FraudAnalysisRequestedEvent",
  "doc": "Request for MARL-based fraud detection from risk-engine to MARL orchestrator",
  "fields": [
    {
      "name": "riskCheckRequestId",
      "type": "string",
      "doc": "Unique request identifier (UUID) stored in risk-engine"
    },
    {
      "name": "paymentId",
      "type": "string",
      "doc": "Internal payment identifier from payment engine"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Request timestamp in milliseconds since epoch"
    },
    {
      "name": "isCrossBorderPayment",
      "type": "boolean",
      "default": false,
      "doc": "Whether this is a cross-border payment (sender and receiver in different countries)"
    },
    {
      "name": "transactionFeatures",
      "type": {
        "type": "record",
        "name": "TransactionFeatures",
        "doc": "Transaction-level features for fraud detection",
        "fields": [
          {
            "name": "paymentId",
            "type": "string",
            "doc": "Internal payment identifier from payment engine"
          },
          {
            "name": "time",
            "type": "string",
            "doc": "Transaction time (HH:MM:SS)"
          },
          {
            "name": "date",
            "type": "string",
            "doc": "Transaction date (YYYY-MM-DD)"
          },
          {
            "name": "senderAccount",
            "type": "string",
            "doc": "Sender account identifier/number"
          },
          {
            "name": "receiverAccount",
            "type": "string",
            "doc": "Receiver account identifier/number"
          },
          {
            "name": "amount",
            "type": "double",
            "doc": "Transaction amount"
          },
          {
            "name": "paymentCurrency",
            "type": "string",
            "doc": "Currency paid (USD, EUR, GBP, etc.)"
          },
          {
            "name": "receivedCurrency",
            "type": "string",
            "doc": "Currency received (USD, EUR, GBP, etc.)"
          },
          {
            "name": "senderBankLocation",
            "type": "string",
            "doc": "Sender bank country/location"
          },
          {
            "name": "receiverBankLocation",
            "type": "string",
            "doc": "Receiver bank country/location"
          },
          {
            "name": "paymentType",
            "type": "string",
            "doc": "Payment method (ACH, Cash Deposit, Cheque, Credit card, Debit card, Cross-border)"
          }
        ]
      },
      "doc": "Transaction-level features for fraud detection"
    },
    {
      "name": "customerFeatures",
      "type": {
        "type": "record",
        "name": "CustomerFeatures",
        "doc": "Customer behavioral features for risk assessment",
        "fields": [
          {
            "name": "customerId",
            "type": "string",
            "doc": "Unique customer identifier"
          },
          {
            "name": "accountId",
            "type": "string",
            "doc": "Account identifier"
          },
          {
            "name": "transactionCount",
            "type": "int",
            "doc": "Total number of transactions"
          },
          {
            "name": "totalAmount",
            "type": "double",
            "doc": "Total transaction amount"
          },
          {
            "name": "avgAmount",
            "type": "double",
            "doc": "Average transaction amount"
          },
          {
            "name": "medianAmount",
            "type": "double",
            "doc": "Median transaction amount"
          },
          {
            "name": "maxAmount",
            "type": "double",
            "doc": "Maximum transaction amount"
          },
          {
            "name": "minAmount",
            "type": "double",
            "doc": "Minimum transaction amount"
          },
          {
            "name": "stdAmount",
            "type": "double",
            "doc": "Standard deviation of transaction amounts"
          },
          {
            "name": "activeDays",
            "type": "int",
            "doc": "Number of days with transactions"
          },
          {
            "name": "transactionsPerDay",
            "type": "double",
            "doc": "Average transactions per day"
          },
          {
            "name": "crossBorderRatio",
            "type": "double",
            "doc": "Ratio of cross-border transactions"
          },
          {
            "name": "cashTransactionRatio",
            "type": "double",
            "doc": "Ratio of cash transactions"
          },
          {
            "name": "amountConsistency",
            "type": "double",
            "doc": "Consistency of transaction amounts"
          },
          {
            "name": "largeTransactionRatio",
            "type": "double",
            "doc": "Ratio of large transactions"
          },
          {
            "name": "uniqueReceivers",
            "type": "int",
            "doc": "Number of unique receivers"
          },
          {
            "name": "uniqueReceiverCountries",
            "type": "int",
            "doc": "Number of unique receiver countries"
          },
          {
            "name": "receiverDiversity",
            "type": "double",
            "doc": "Diversity score of receivers"
          },
          {
            "name": "nightTransactionRatio",
            "type": "double",
            "doc": "Ratio of transactions at night"
          },
          {
            "name": "weekendTransactionRatio",
            "type": "double",
            "doc": "Ratio of weekend transactions"
          },
          {
            "name": "uniqueCurrencies",
            "type": "int",
            "doc": "Number of unique currencies used"
          }
        ]
      },
      "doc": "Customer behavioral features for risk assessment"
    },
    {
      "name": "networkFeatures",
      "type": {
        "type": "record",
        "name": "NetworkFeatures",
        "doc": "Local ego-net and money-flow features from the transaction graph",
        "fields": [
          {
            "name": "accountId",
            "type": "string",
            "doc": "Account identifier in the network graph"
          },
          {
            "name": "uniqueInCounterparties",
            "type": "int",
            "doc": "Distinct accounts that sent money to this account"
          },
          {
            "name": "uniqueOutCounterparties",
            "type": "int",
            "doc": "Distinct accounts this account sent money to"
          },
          {
            "name": "reciprocity",
            "type": "double",
            "doc": "Counterparties transacted with in both directions over all counterparties (0-1)"
          },
          {
            "name": "cycle3Count",
            "type": "int",
            "doc": "Distinct accounts closing a directed 3-cycle through this account"
          },
          {
            "name": "twoHopOutReach",
            "type": "int",
            "doc": "Distinct accounts reachable in exactly two outgoing hops"
          },
          {
            "name": "inOutAmountRatio",
            "type": "double",
            "doc": "Total outgoing amount over total incoming amount plus one (pass-through signal)"
          },
          {
            "name": "inConcentration",
            "type": "double",
            "doc": "Herfindahl concentration of incoming amounts by counterparty (0-1)"
          },
          {
            "name": "outConcentration",
            "type": "double",
            "doc": "Herfindahl concentration of outgoing amounts by counterparty (0-1)"
          },
          {
            "name": "forwardingGapHours",
            "type": "double",
            "doc": "Median hours between an outgoing payment and the most recent incoming one, capped at 168"
          },
          {
            "name": "peakDayShare",
            "type": "double",
            "doc": "Busiest day's share of the account's payments (0-1)"
          }
        ]
      },
      "doc": "Network topology features from transaction graph"
    }
  ]
}
